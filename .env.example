# 百度网盘 NAS 自动下载服务配置示例
# 复制此文件为 .env 并填入你的真实配置

# 百度网盘 App 凭证（请勿提交到 Git）
BAIDU_APP_ID=你的AppID
BAIDU_APP_KEY=你的AppKey
BAIDU_SECRET_KEY=你的SecretKey
BAIDU_SIGN_KEY=你的SignKey

# 百度网盘 Access Token（通过 OAuth 授权获取）
# 首次运行前，需要先手动获取 Access Token
BAIDU_ACCESS_TOKEN=your_access_token_here
BAIDU_REFRESH_TOKEN=your_refresh_token_here

# 业务配置
QUEUE_DIR=/NAS_Download_Queue
LOCAL_DOWNLOAD_DIR=./downloads
SCAN_INTERVAL=300
MAX_PARALLEL=2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5

# HTTP 服务端口
SERVER_PORT=8080
SERVER_HOST=127.0.0.1
# Optional Docker Compose process UID:GID; empty keeps 0:0.
RUN_AS=
PUBLIC_ORIGIN=
