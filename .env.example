# 百度网盘 NAS 自动下载服务配置示例
# 复制此文件为 .env 并填入你的真实配置

# 百度网盘 App 凭证（请勿提交到 Git）
BAIDU_APP_ID=你的AppID
BAIDU_APP_KEY=你的AppKey
BAIDU_SECRET_KEY=你的SecretKey
BAIDU_SIGN_KEY=你的SignKey

# 百度网盘 Token（可留空，在管理页面 /oauth 进行设备授权）
BAIDU_ACCESS_TOKEN=
BAIDU_REFRESH_TOKEN=
# Optional administrator password (16+ bytes); empty generates a private key.
ADMIN_PASSWORD=

# Compose 配置。QUEUE_DIR 是百度网盘远端目录；本地下载固定挂载在 ./downloads。
QUEUE_DIR=/NAS_Download_Queue
SCAN_INTERVAL=30
HOST_PORT=8080
MAX_PARALLEL=2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
# Optional Docker Compose process UID:GID; empty keeps 0:0.
RUN_AS=
PUBLIC_ORIGIN=

# Optional source-image metadata (used by docker-compose build only)
BUILD_VERSION=dev
BUILD_REVISION=unknown
