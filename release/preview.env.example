# Supply an access token, or configure app credentials for web device authorization.
BAIDU_ACCESS_TOKEN=
BAIDU_REFRESH_TOKEN=
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
# Optional (16+ bytes). Empty generates downloads/.nas-downloader/queue/admin-key.json.
ADMIN_PASSWORD=
QUEUE_DIR=/NAS_Download_Queue_preview
MAX_PARALLEL=2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
