# Supply an access token, or configure app credentials for web device authorization.
BAIDU_ACCESS_TOKEN=
BAIDU_REFRESH_TOKEN=
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
# Optional (16+ bytes). Empty generates downloads/.nas-downloader/queue/admin-key.json.
ADMIN_PASSWORD=
# Optional UID:GID for a prepared writable bind mount. Empty keeps 0:0.
RUN_AS=
# Optional external HTTPS origin when a proxy terminates TLS (no path prefix).
PUBLIC_ORIGIN=
QUEUE_DIR=/NAS_Download_Queue_preview
MAX_PARALLEL=2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
