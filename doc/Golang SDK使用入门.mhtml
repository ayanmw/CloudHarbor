.is-phone .sider { display: none; }

.is-phone .main { width: 100%; margin: 0px; }

.is-phone .main img, .is-phone .post-wrapper { width: 100%; }

.post__body { overflow: auto; }

.post__body img { max-width: 100%; }

.post__body ul { list-style: outside disc; padding-left: 18px; margin: 5px =
0px; }

.post__body ul.nav-tabs { list-style: none; padding-left: 0px; margin: 0px;=
 }

.post__body ul li { list-style: outside disc; }

.post__body li { line-height: 26px; margin: 14px 0px; }

.post__body li ul { margin-top: 10px; }

.post__body li ul li, .post__body li ul li ul { margin-top: 5px; }

.post__body li p { margin: 5px 0px; }

.post__body ol { padding-left: 20px; }

.post__body ol, .post__body ol > li { list-style: outside decimal; }

.post__body li > ol, .post__body li > ul { margin-left: 20px; }

.sider .secondary-nav { clear: both; overflow-y: hidden; height: calc(-62px=
 + 100vh); }

.gatsby-code-button-container { touch-action: none; display: flex; justify-=
content: flex-end; position: relative; top: 28px; z-index: 100; pointer-eve=
nts: none; }

.gatsby-code-button { cursor: pointer; pointer-events: auto; }

.gatsby-code-button::after { visibility: hidden; position: absolute; displa=
y: none; padding: 5px; content: attr(data-tooltip); color: rgb(255, 255, 25=
5); font-size: 16px; background-color: rgb(0, 0, 0); white-space: nowrap; }

.gatsby-code-button[data-tooltip]::after { top: 26px; right: 0px; }

.gatsby-code-button[data-tooltip]:focus::after, .gatsby-code-button[data-to=
oltip]:hover::after { visibility: visible; display: block; z-index: 200; }

.gatsby-code-button-toaster { z-index: 500; position: fixed; inset: 0px; di=
splay: flex; justify-content: center; align-items: center; height: 100vh; w=
idth: 100vw; pointer-events: none; }

.gatsby-code-button-toaster-text { width: 100%; margin: 0px 15px; max-width=
: 850px; padding: 20px; font-size: 24px; letter-spacing: -1px; font-family:=
 monospace; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); bord=
er-radius: 2px; text-align: center; opacity: 0; animation: 3s cubic-bezier(=
0.98, 0.01, 0.53, 0.47) 0s 1 normal none running animation; }

